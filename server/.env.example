# 数据后端环境变量示例
# 复制为 .env 并按需修改

# 服务端口
PORT=3001

# SQLite 数据库文件路径（默认 server/data/rt_asset.db）
# DB_PATH=/app/data/rt_asset.db

# CORS 允许的前端源（逗号分隔，* 表示全部）
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 高德 Web 服务 API Key（用于 POI 周边搜索爬虫）
# 申请地址：https://lbs.amap.com/api/webservice/guide/create-project/get-key
# 注意：Web 服务 API key 与 JS API key 不同，需在高德控制台单独创建
AMAP_API_KEY=your-amap-web-service-api-key
