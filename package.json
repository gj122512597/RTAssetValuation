{
  "name": "rt-asset-valuation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "server:install": "cd server && npm install",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm start",
    "server:db:init": "cd server && npm run db:init",
    "server:db:seed": "cd server && npm run db:seed",
    "server:db:migrate": "cd server && npm run db:migrate-mocks",
    "crawl:poi": "cd server && npm run crawl:poi",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run server:dev\""
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.18.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "mapbox-gl": "^3.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.6",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
