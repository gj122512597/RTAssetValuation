{
  "name": "rt-asset-valuation-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XX地产资产评估系统 - 数据后端（SQLite + Express），用于存储爬取的外部数据",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:seed": "tsx src/scripts/seedDemo.ts",
    "db:migrate-mocks": "tsx src/scripts/migrateMocks.ts",
    "crawl:poi": "tsx src/scripts/crawlPoi.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
