# ===== 高德地图 JS API（Web 端 v2.0） =====
# 申请地址: https://lbs.amap.com/api/jsapi-v2/guide/abc/prepare
VITE_AMAP_KEY=your-amap-jsapi-web-key
# 可选：若启用了安全密钥
VITE_AMAP_SECURITY=your-security-code

# ===== 数据后端 API =====
# 默认 http://localhost:3001/api，Docker 部署时改为 http://<host>:3001/api
VITE_API_BASE_URL=http://localhost:3001/api
